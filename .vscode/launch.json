{
  "version": "0.2.0",
  "configurations": [
    {
      // Chay va debug phia server: dat breakpoint thang trong cac Server
      // Component o components/views/ hoac trong lib/api-football.ts.
      "name": "Next.js: debug server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      // Chi debug phia trinh duyet (component "use client" nhu SiteNav).
      // Can dev server dang chay san.
      "name": "Next.js: debug client (can dev dang chay)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
